pragma cashscript ^0.11.0;

// PennyPicker oracle-relative BPS limit order on the BCH/PUSD pair
// (price = PUSD per BCH). One order per P2SH32 address; escrow and proceeds
// live in a single UTXO at this address:
//   side 0 (ask): sells BCH. Holds BCH; fills remove BCH and add PUSD.
//   side 1 (bid): buys BCH.  Holds PUSD; fills remove PUSD and add BCH.
//
// Fills must spend the PennyPicker oracle-state UTXO at input 0 and recreate it at
// output 0; the output's mutable NFT commitment starts with price:int64le =
// PUSD per BCH scaled by 1e8 (BCH/USD from the oracle; PUSD stands in for USD).
// The limit is price * (10000 + deltaBps) / 10000 (asks use deltaBps >= 0, bids
// deltaBps <= 0 by app convention). Settlement is exact, with no rounding:
//   dUnits * 1e18 + dSat * price * (10000 + deltaBps) >= 0
// where dUnits is the change in PUSD base units (1/100 PUSD) and dSat the change
// in satoshis held by the order. Derivation: s sats are worth
// s * limit / 1e14 base units (1e8 sats/BCH * 1e8 price scale / 100 units/PUSD),
// and limit = price * (10000 + deltaBps) / 10000, giving the 1e18 constant.
contract PennyPickerOrder(
    bytes32 oracleCategory,
    bytes32 pusdCategory,
    bytes20 makerPkh,
    int side,
    int deltaBps
) {
    function fill() {
        int i = this.activeInputIndex;
        require(i > 0);
        require(10000 + deltaBps > 0);

        // Authentic oracle state: the only mutable NFT of its category is spent at
        // input 0 and carried forward at output 0. The price is read from output 0,
        // which the oracle contract only lets hold the unchanged state or a newer
        // signed oracle message, so a fill can refresh the price in the same transaction.
        require(tx.inputs[0].tokenCategory == oracleCategory + 0x01);
        require(tx.outputs[0].tokenCategory == oracleCategory + 0x01);
        bytes priceBin = tx.outputs[0].nftCommitment.split(8)[0];
        int price = int(priceBin);
        require(price > 0);

        // The order continues at the same index and address.
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);

        int inUnits = tx.inputs[i].tokenAmount;
        int outUnits = tx.outputs[i].tokenAmount;
        if (inUnits > 0) {
            require(tx.inputs[i].tokenCategory == pusdCategory);
        }
        if (outUnits > 0) {
            require(tx.outputs[i].tokenCategory == pusdCategory);
        }

        int dUnits = outUnits - inUnits;
        int dSat = tx.outputs[i].value - tx.inputs[i].value;

        if (side == 0) {
            require(dUnits > 0);
        } else {
            require(dUnits < 0);
        }

        require(dUnits * 1000000000000000000 + dSat * price * (10000 + deltaBps) >= 0);
    }

    // The maker withdraws escrow and proceeds. Authorised by an input from the
    // maker's P2PKH address directly after the order input; the maker's wallet
    // signs that ordinary input, committing to all outputs.
    function cancel() {
        require(tx.inputs[this.activeInputIndex + 1].lockingBytecode == new LockingBytecodeP2PKH(makerPkh));
    }
}
