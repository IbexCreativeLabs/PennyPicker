pragma cashscript ^0.11.0;

// PennyPicker oracle-relative BPS limit order (one order per P2SH32 address).
//
// Escrow and proceeds live in a single UTXO at this address:
//   side 0 (buy PUSD):  UTXO holds BCH; fills deliver PUSD into it and remove BCH.
//   side 1 (sell PUSD): UTXO holds PUSD; fills remove PUSD and add BCH to it.
//
// Fills must spend the PennyPicker oracle-state UTXO at input 0. Its mutable NFT
// commitment starts with rate:int64le = satoshis per whole PUSD, scaled by 1e8.
// The effective limit is rate * (10000 + deltaBps) / 10000. The settlement check is
// exact (no rounding): dSat * 1e14 + dUnits * rate * (10000 + deltaBps) >= 0,
// where 1e14 = 100 PUSD units * 1e8 rate scale * 10000 BPS denominator.
contract PennyPickerOrder(
    bytes32 oracleCategory,
    bytes32 pusdCategory,
    bytes20 makerPkh,
    int side,
    int deltaBps,
    int targetUnits
) {
    function fill() {
        int i = this.activeInputIndex;
        require(i > 0);

        // Authentic current oracle state: the only mutable NFT of its category.
        require(tx.inputs[0].tokenCategory == oracleCategory + 0x01);
        bytes rateBin = tx.inputs[0].nftCommitment.split(8)[0];
        int rate = int(rateBin);
        require(rate > 0);

        // The order continues at the same index and address.
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);

        int inUnits = tx.inputs[i].tokenAmount;
        int outUnits = tx.outputs[i].tokenAmount;
        if (inUnits > 0) {
            require(tx.inputs[i].tokenCategory == pusdCategory);
        }
        if (outUnits > 0) {
            require(tx.outputs[i].tokenCategory == pusdCategory);
        }

        int dUnits = outUnits - inUnits;
        int dSat = tx.outputs[i].value - tx.inputs[i].value;

        if (side == 0) {
            require(dUnits > 0);
            require(outUnits <= targetUnits);
        } else {
            require(dUnits < 0);
        }

        require(dSat * 100000000000000 + dUnits * rate * (10000 + deltaBps) >= 0);
    }

    // The maker withdraws escrow and proceeds, closing or replacing the order.
    function cancel(pubkey makerPk, sig makerSig) {
        require(hash160(makerPk) == makerPkh);
        require(checkSig(makerSig, makerPk));
    }
}
