pragma cashscript ^0.11.0;

// PennyPicker BCH/PUSD reference-price state (price = PUSD per BCH).
//
// Holds the single mutable NFT of the oracle category (genesis mints no minting
// baton). Commitment (16 bytes):
//   price:int64le     PUSD per BCH, scaled by 1e8 (> 0)
//   timestamp:int32le unix seconds claimed by the operator
//   sequence:int32le  strictly increasing update counter
//
// Freshness model: fills must spend and recreate this UTXO unchanged, so a
// superseded price is an already-spent output and cannot be used. The maximum
// age of the current price is the operator's update cadence; the script cannot
// observe wall-clock time, so it does not enforce a maximum age.
contract PennyPickerOracle(bytes20 operatorPkh) {
    // Authorised by an input from the operator's P2PKH address placed directly
    // after the oracle input. The operator's wallet signs that ordinary input
    // (SIGHASH_ALL), which commits to every output, including the new price.
    function update() {
        int i = this.activeInputIndex;
        require(tx.inputs[i + 1].lockingBytecode == new LockingBytecodeP2PKH(operatorPkh));
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].tokenAmount == tx.inputs[i].tokenAmount);

        bytes next = tx.outputs[i].nftCommitment;
        require(next.length == 16);
        bytes nextPrice, bytes nextTail = next.split(8);
        bytes nextTime, bytes nextSeq = nextTail.split(4);
        bytes prevTail = tx.inputs[i].nftCommitment.split(8)[1];
        bytes prevTime, bytes prevSeq = prevTail.split(4);
        require(int(nextPrice) > 0);
        require(int(nextTime) >= int(prevTime));
        require(int(nextSeq) > int(prevSeq));
    }

    // Anyone may spend the state to read it, if it is recreated unchanged.
    function read() {
        int i = this.activeInputIndex;
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].tokenAmount == tx.inputs[i].tokenAmount);
        require(tx.outputs[i].nftCommitment == tx.inputs[i].nftCommitment);
        require(tx.outputs[i].value >= tx.inputs[i].value);
    }
}
