# WalletConnect Project ID from the WalletConnect/Reown dashboard.
# Project IDs are public client configuration; never put keys or seed phrases here.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# PennyPicker Chipnet market identity (optional overrides). The committed defaults in
# src/lib/pennypicker/deployment.ts are used when these are unset.
# All three are public on-chain identifiers, not secrets.
VITE_PENNYPICKER_PUSD_CATEGORY=
VITE_PENNYPICKER_ORACLE_CATEGORY=
VITE_PENNYPICKER_ORACLE_OPERATOR_PKH=

# Deployment (Cloudflare Pages) — see DEPLOYMENT.md.
# Build-time variables set in the Pages dashboard: NODE_VERSION=22, PNPM_VERSION=10.6.3,
# VITE_WALLETCONNECT_PROJECT_ID. Every VITE_* value is embedded in the public JavaScript
# bundle, so never put keys, passwords or seed phrases here.
