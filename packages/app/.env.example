# WalletConnect Project ID from the WalletConnect/Reown dashboard.
# Project IDs are public client configuration; never put keys or seed phrases here.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# PennyPicker Chipnet market identity (optional). When unset, the app uses values
# saved in this browser after running PUSD genesis (/penny-picker/token) and
# oracle genesis (/penny-picker/oracle), or values pasted on /penny-picker/exchange.
# All three are public on-chain identifiers, not secrets.
VITE_PENNYPICKER_PUSD_CATEGORY=
VITE_PENNYPICKER_ORACLE_CATEGORY=
VITE_PENNYPICKER_ORACLE_OPERATOR_PKH=
